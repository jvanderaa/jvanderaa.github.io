{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/fixtures/**",
    "archive/**",
    "_archive/**",
    "temp/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep HUGO_VERSION in GitHub workflows in step with .tool-versions",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "HUGO_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "hugo",
      "packageNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Bump Hugo in .tool-versions and workflows in one PR",
      "matchPackageNames": [
        "hugo",
        "gohugoio/hugo"
      ],
      "groupName": "hugo"
    }
  ]
}
